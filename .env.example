# Copy this file to `.env` in the repo root before running
# `docker compose -f docker-compose.yml up -d` — compose reads variables for
# substitution (${DATABASE_URL}, etc.) from a `.env` file next to it.

APP_NAME="Book Notes"
DEBUG=true
DATABASE_URL="postgresql+asyncpg://myuser:mypassword@db:5432/mydatabase"
SECRET_KEY=change-me-to-a-random-secret

# JSON list of origins allowed to call the API from a browser. Must include
# wherever the frontend is actually served from.
CORS_ORIGINS=["http://localhost:5173"]

# Build-time only: baked into the frontend's JS bundle by its Dockerfile, so
# rebuild the frontend image after changing this. Point it at the backend
# container for an all-local stack, or at your own deployed backend.
VITE_API_URL=http://localhost:8000
